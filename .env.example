# Sincronização com o Supabase (opcional). Sem isso, o app funciona só no aparelho.
# Pegue os valores em: Supabase > seu projeto > Connect (ou Project Settings > API Keys).
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
